{
  "name": "pi-omniroute-lite",
  "version": "1.0.0",
  "description": "Minimal pi extension: connect a local OmniRoute gateway as a real OpenAI-compatible provider.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "omniroute",
    "openai-compatible"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "npm run typecheck",
    "install-ext": "node scripts/install.mjs",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mgoku/pi-omniroute-lite.git"
  }
}
